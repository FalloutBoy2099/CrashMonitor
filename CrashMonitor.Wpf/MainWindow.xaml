<Window
    x:Class="CrashMonitor.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CrashMonitor"
    Width="1080"
    Height="720"
    MinWidth="920"
    MinHeight="620"
    FontFamily="Segoe UI"
    FontSize="13"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="230" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabControl" Grid.Row="0">
            <TabItem Header="Dump">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Dump" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding DumpPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Command="{Binding BrowseDumpCommand}"
                        Content="..." />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Known errors" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding KnownErrorsPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Command="{Binding BrowseKnownErrorsCommand}"
                        Content="..." />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Context" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding ContextPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Command="{Binding BrowseContextCommand}"
                        Content="..." />

                    <Button
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="120"
                        HorizontalAlignment="Left"
                        Command="{Binding AnalyzeDumpCommand}"
                        Content="Analyze dump" />
                </Grid>
            </TabItem>

            <TabItem Header="INT Script">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Script" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Command="{Binding BrowseScriptCommand}"
                        Content="..." />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Unsafe address" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding UnsafeAddress, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="120"
                        HorizontalAlignment="Left"
                        Command="{Binding AnalyzeScriptCommand}"
                        Content="Analyze script" />
                </Grid>
            </TabItem>

            <TabItem Header="sfall Debug">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Output" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding DebugOutputPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Command="{Binding BrowseDebugOutputCommand}"
                        Content="..." />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Arrays" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding ArrayIndexes, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Script locals" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding LocalScriptIds, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Critter locals" />
                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        VerticalContentAlignment="Center"
                        Text="{Binding CritterIndexes, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Max rows" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Width="100"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        Text="{Binding MaxRows, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Row="5"
                        Grid.Column="1"
                        Width="160"
                        HorizontalAlignment="Left"
                        Command="{Binding CaptureSfallCommand}"
                        Content="Capture sfall snapshot" />
                </Grid>
            </TabItem>
        </TabControl>

        <TextBox
            Grid.Row="1"
            Margin="0,8,0,8"
            AcceptsReturn="True"
            AcceptsTab="True"
            FontFamily="Consolas"
            FontSize="13"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="False"
            Text="{Binding Report, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>

</Window>